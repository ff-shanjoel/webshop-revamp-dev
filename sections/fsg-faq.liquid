{%- liquid
  assign s = section.settings
  assign fallback_contact = 'mailto:' | append: shop.email
-%}

<section
  class="fsg fsg-sec fsg-faq{% if s.background == 'mist' %} fsg-sec--mist{% endif %}"
  style="--fsg-pt: {{ s.padding_top }}px; --fsg-pb: {{ s.padding_bottom }}px;"
>
  <div class="fsg-wrap fsg-faq__grid">
    <div class="fsg-faq__intro">
      {%- if s.eyebrow != blank -%}<p class="fsg-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="fsg-h2">{{ s.heading }}</h2>{%- endif -%}
      {%- if s.text != blank -%}<div class="fsg-rte">{{ s.text }}</div>{%- endif -%}
      {%- if s.button_label != blank -%}
        <a href="{{ s.button_link | default: fallback_contact }}" class="fsg-btn fsg-btn--primary">
          {{- s.button_label }}
          {% render 'fsg-icon', icon: 'arrow-right', size: 17 -%}
        </a>
      {%- endif -%}
    </div>

    <div class="fsg-faq__list" data-fsg-faq>
      {%- for block in section.blocks -%}
        <details class="fsg-faq__item" {{ block.shopify_attributes }} {% if forloop.first and s.open_first %}open{% endif %}>
          <summary>
            <span>{{ block.settings.question }}</span>
            <span class="fsg-faq__toggle" aria-hidden="true">{% render 'fsg-icon', icon: 'plus', size: 18 %}</span>
          </summary>
          <div class="fsg-rte fsg-faq__answer">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{%- if section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "FSG FAQ",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "FAQ"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Questions we get asked a lot"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Can't find your answer? Our team is happy to help.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Contact us"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Leave empty to open an email to the store address."
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open first question",
      "default": true
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "default": "white",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "mist", "label": "Mist" }
      ]
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Answer</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FSG FAQ",
      "blocks": [{ "type": "question" }, { "type": "question" }, { "type": "question" }]
    }
  ]
}
{% endschema %}
