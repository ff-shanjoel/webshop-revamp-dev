{%- liquid
  assign s = section.settings
  assign benefits = section.blocks | where: 'type', 'benefit'
  assign fallback_contact = 'mailto:' | append: shop.email
-%}

<section
  class="fsg fsg-sec fsg-hero"
  style="--fsg-pt: {{ s.padding_top }}px; --fsg-pb: {{ s.padding_bottom }}px; --fsg-hero-img: {{ s.image_opacity | divided_by: 100.0 }}; --fsg-hero-min: {{ s.min_height }}px;"
>
  <div class="fsg-wrap">
    <div class="fsg-hero__banner">
      <div class="fsg-hero__media">
        {% render 'fsg-image',
          image: s.image,
          product: s.fallback_product,
          photo: s.fallback_photo,
          sizes: '(min-width: 1320px) 1280px, 100vw',
          eager: true
        %}
      </div>
      <div class="fsg-hero__content">
        {%- if s.eyebrow != blank -%}
          <p class="fsg-eyebrow fsg-hero__eyebrow">{{ s.eyebrow }}</p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h1 class="fsg-hero__title">{{ s.heading }}</h1>
        {%- endif -%}
        {%- if s.text != blank -%}
          <div class="fsg-hero__text">{{ s.text }}</div>
        {%- endif -%}
        {%- if s.button_label != blank or s.button_2_label != blank -%}
          <div class="fsg-hero__actions">
            {%- if s.button_label != blank -%}
              <a href="{{ s.button_link | default: routes.all_products_collection_url }}" class="fsg-btn fsg-btn--light">
                {{- s.button_label }}
                {% render 'fsg-icon', icon: 'arrow-right', size: 17 -%}
              </a>
            {%- endif -%}
            {%- if s.button_2_label != blank -%}
              <a href="{{ s.button_2_link | default: fallback_contact }}" class="fsg-btn fsg-btn--ghost">{{ s.button_2_label }}</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- if benefits.size > 0 -%}
      <ul class="fsg-benefits" role="list">
        {%- for block in benefits -%}
          <li class="fsg-benefit fsg-rv" style="--fsg-rv-delay: {{ forloop.index0 | times: 0.06 }}s" {{ block.shopify_attributes }}>
            <span class="fsg-benefit__icon">{% render 'fsg-icon', icon: block.settings.icon, size: 22 %}</span>
            <span>
              <strong>{{ block.settings.title }}</strong>
              {%- if block.settings.text != blank -%}
                <small>{{ block.settings.text }}</small>
              {%- endif -%}
            </span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "FSG hero",
  "tag": "div",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "product",
      "id": "fallback_product",
      "label": "Use a product photo",
      "info": "Used when no image is uploaded."
    },
    {
      "type": "range",
      "id": "fallback_photo",
      "label": "Product photo number",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "image_opacity",
      "label": "Image visibility",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 55
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Banner height (desktop)",
      "min": 360,
      "max": 720,
      "step": 20,
      "unit": "px",
      "default": 520
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Ireland's floor specialists"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Entrance matting, trims and protection for every building."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Commercial-grade matting, made-to-measure logo mats and eco floor care — supplied and fitted across Ireland.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop entrance matting"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Second button label",
      "default": "Get a quote"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Second button link",
      "info": "Leave empty to open an email to the store address."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit tile",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "truck",
          "options": [
            { "value": "truck", "label": "Delivery" },
            { "value": "shield", "label": "Warranty" },
            { "value": "ruler", "label": "Made to measure" },
            { "value": "chat", "label": "Advice" },
            { "value": "leaf", "label": "Eco" },
            { "value": "clock", "label": "Clock" },
            { "value": "check", "label": "Tick" }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Fast delivery"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "2–3 working days"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FSG hero",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "truck", "title": "Fast delivery", "text": "2–3 working days, €15 ROI" } },
        { "type": "benefit", "settings": { "icon": "shield", "title": "Up to 5-year warranty", "text": "On entrance systems" } },
        { "type": "benefit", "settings": { "icon": "ruler", "title": "Made to measure", "text": "Cut & shaped on site" } },
        { "type": "benefit", "settings": { "icon": "chat", "title": "Expert advice", "text": "Same-day quotes" } }
      ]
    }
  ]
}
{% endschema %}
