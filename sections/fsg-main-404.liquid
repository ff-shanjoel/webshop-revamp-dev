{%- liquid
  assign s = section.settings
  assign phone_href = s.phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-'
-%}

{{ 'fsg-pages.css' | asset_url | stylesheet_tag }}

<section class="fsg fsg-plp fsg-404">
  <div class="fsg-wrap">
    <div class="fsg-404__box">
      <p class="fsg-404__code" aria-hidden="true">404</p>
      <h1 class="fsg-404__title">{{ s.heading }}</h1>
      {%- if s.text != blank -%}<p class="fsg-404__text">{{ s.text }}</p>{%- endif -%}

      <form action="{{ routes.search_url }}" method="get" role="search" class="fsg-search-page__form fsg-404__search">
        <label class="visually-hidden" for="Fsg404Search">Search</label>
        <input
          id="Fsg404Search"
          class="fsg-search-page__input"
          type="search"
          name="q"
          placeholder="{{ s.placeholder | escape }}"
          autocomplete="off"
        >
        <input type="hidden" name="options[prefix]" value="last">
        <button type="submit" class="fsg-btn fsg-btn--primary">
          {% render 'fsg-icon', icon: 'search', size: 18 %}
          Search
        </button>
      </form>

      <div class="fsg-404__actions">
        <a href="{{ routes.root_url }}" class="fsg-btn fsg-btn--outline">Back to the homepage</a>
        <a href="{{ routes.collections_url }}" class="fsg-btn fsg-btn--outline">All categories</a>
        {%- if s.phone != blank -%}
          <a href="tel:{{ phone_href }}" class="fsg-btn fsg-btn--outline">
            {% render 'fsg-icon', icon: 'phone', size: 17 %}
            {{ s.phone }}
          </a>
        {%- endif -%}
      </div>
    </div>

    {%- if s.menu != blank -%}
      <div class="fsg-search-page__browse">
        <h2 class="fsg-h3">{{ s.browse_heading }}</h2>
        <ul class="fsg-tiles__grid fsg-search-page__grid" role="list">
          {%- assign tile_count = 0 -%}
          {%- for link in s.menu.links -%}
            {%- for child in link.links -%}
              {%- if child.type != 'collection_link' or child.object.products_count == 0 -%}{%- continue -%}{%- endif -%}
              {%- if tile_count >= s.browse_limit -%}{%- break -%}{%- endif -%}
              {%- assign tile_count = tile_count | plus: 1 -%}
              <li>{% render 'fsg-collection-tile', collection: child.object, title: child.title %}</li>
            {%- endfor -%}
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "FSG page not found",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "We can't find that page"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "The link may be old or the page may have moved. Try a search, or pick a category below."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Search placeholder",
      "default": "Search mats, trims, cleaners…"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone",
      "default": "(085) 1234 899"
    },
    {
      "type": "text",
      "id": "browse_heading",
      "label": "Categories heading",
      "default": "Popular categories"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Categories from menu",
      "default": "main-menu"
    },
    {
      "type": "range",
      "id": "browse_limit",
      "label": "Categories to show",
      "min": 4,
      "max": 16,
      "step": 4,
      "default": 8
    }
  ]
}
{% endschema %}
