{%- assign s = section.settings -%}

<section
  class="fsg fsg-sec fsg-tiles{% if s.background == 'mist' %} fsg-sec--mist{% endif %}"
  style="--fsg-pt: {{ s.padding_top }}px; --fsg-pb: {{ s.padding_bottom }}px; --fsg-cols: {{ s.columns }};"
>
  <div class="fsg-wrap">
    {%- if s.heading != blank or s.eyebrow != blank -%}
      <div class="fsg-sec-head">
        <div class="fsg-sec-head__text">
          {%- if s.eyebrow != blank -%}<p class="fsg-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
          {%- if s.heading != blank -%}<h2 class="fsg-h2">{{ s.heading }}</h2>{%- endif -%}
        </div>
        {%- if s.link_label != blank -%}
          <a href="{{ s.link | default: routes.collections_url }}" class="fsg-sec-head__link">
            {{- s.link_label }}
            {% render 'fsg-icon', icon: 'arrow-right', size: 16 -%}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul class="fsg-tiles__grid" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign c = block.settings.collection
          assign title = block.settings.title | default: c.title
          assign img = block.settings.image
          if img == blank and c != blank
            assign img = c.image | default: c.products.first.featured_image
          endif
        -%}
        <li class="fsg-rv" style="--fsg-rv-delay: {{ forloop.index0 | modulo: s.columns | times: 0.05 }}s" {{ block.shopify_attributes }}>
          <a href="{{ c.url | default: '#' }}" class="fsg-tile">
            <span class="fsg-tile__media">
              {%- if img != blank -%}
                {{
                  img
                  | image_url: width: 900
                  | image_tag:
                    widths: '300, 450, 600, 900',
                    sizes: '(min-width: 1200px) 320px, (min-width: 750px) 33vw, 50vw',
                    loading: 'lazy',
                    alt: title
                }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'fsg-placeholder' }}
              {%- endif -%}
            </span>
            <span class="fsg-tile__body">
              <span class="fsg-tile__title">{{ title | default: 'Collection' }}</span>
              {%- if s.show_count and c != blank -%}
                <span class="fsg-tile__count">{{ c.products_count }} products</span>
              {%- endif -%}
            </span>
            <span class="fsg-tile__arrow">{% render 'fsg-icon', icon: 'arrow-right', size: 16 %}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "FSG collection tiles",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shop by category"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Popular categories"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "All categories"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (desktop)",
      "min": 3,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Show product count",
      "default": true
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "default": "white",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "mist", "label": "Mist" }
      ]
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title override"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image override",
          "info": "Defaults to the collection image, then its first product."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FSG collection tiles",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
