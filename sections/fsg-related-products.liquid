{%- comment -%}
  "You might also need": Shopify product recommendations, loaded after the page
  renders (the recommendations endpoint re-renders this section with results).
{%- endcomment -%}
{%- assign s = section.settings -%}

<section
  class="fsg fsg-sec fsg-related{% if s.background == 'mist' %} fsg-sec--mist{% endif %}"
  style="--fsg-pt: {{ s.padding_top }}px; --fsg-pb: {{ s.padding_bottom }}px; --fsg-cols: 4;"
  data-fsg-related
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ s.limit }}&intent={{ s.intent }}"
>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="fsg-wrap">
      <div class="fsg-sec-head">
        <div class="fsg-sec-head__text">
          <h2 class="fsg-h2">{{ s.heading }}</h2>
        </div>
      </div>
      <ul class="fsg-featured__grid" role="list">
        {%- for rec in recommendations.products -%}
          <li>
            {% render 'fsg-product-card', card_product: rec, section_id: section.id, badge: 'In stock', show_vendor: true %}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</section>

<script>
  (() => {
    const el = document.currentScript.previousElementSibling;
    if (!el || el.children.length || !el.dataset.url || el.dataset.fsgLoaded) return;
    el.dataset.fsgLoaded = 'true';
    fetch(el.dataset.url)
      .then((r) => r.text())
      .then((html) => {
        const fresh = new DOMParser().parseFromString(html, 'text/html').querySelector('[data-fsg-related]');
        if (fresh && fresh.children.length) el.innerHTML = fresh.innerHTML;
      })
      .catch(() => {});
  })();
</script>

{% schema %}
{
  "name": "FSG related products",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You might also need"
    },
    {
      "type": "select",
      "id": "intent",
      "label": "Show",
      "default": "related",
      "options": [
        { "value": "complementary", "label": "Products that go with it" },
        { "value": "related", "label": "Similar products" }
      ],
      "info": "Products that go with it are set in the Search & Discovery app."
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "default": "mist",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "mist", "label": "Mist" }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ]
}
{% endschema %}
