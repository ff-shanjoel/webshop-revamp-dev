{%- assign s = section.settings -%}

{{ 'fsg-pages.css' | asset_url | stylesheet_tag }}

<section class="fsg fsg-plp fsg-blog">
  <div class="fsg-wrap">
    <nav class="fsg-crumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      {% render 'fsg-icon', icon: 'chevron-right', size: 13 %}
      <span aria-current="page">{{ s.heading | default: blog.title }}</span>
    </nav>

    <header class="fsg-plp__head">
      <h1 class="fsg-plp__title">{{ s.heading | default: blog.title }}</h1>
      {%- if s.intro != blank -%}
        <p class="fsg-plp__desc">{{ s.intro }}</p>
      {%- endif -%}
    </header>

    {%- if blog.all_tags.size > 0 -%}
      <nav class="fsg-chips" aria-label="Topics">
        <a href="{{ blog.url }}" class="fsg-chip{% if current_tags == blank %} is-active{% endif %}" style="padding-left:14px">All</a>
        {%- for tag in blog.all_tags -%}
          <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="fsg-chip{% if current_tags contains tag %} is-active{% endif %}" style="padding-left:14px">
            {{- tag -}}
          </a>
        {%- endfor -%}
      </nav>
    {%- endif -%}

    {%- paginate blog.articles by s.per_page -%}
      {%- if blog.articles.size > 0 -%}
        <ul class="fsg-blog__grid" role="list">
          {%- for article in blog.articles -%}
            {%- assign featured = false -%}
            {%- if forloop.first and paginate.current_page == 1 and current_tags == blank -%}
              {%- assign featured = true -%}
            {%- endif -%}
            <li{% if featured %} class="fsg-blog__featured"{% endif %}>
              {%- if featured -%}
                {% render 'fsg-article-card', article: article, featured: true, sizes: '(min-width: 990px) 640px, 100vw' %}
              {%- else -%}
                {% render 'fsg-article-card', article: article %}
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>

        {%- if paginate.pages > 1 -%}
          <nav class="fsg-pages" aria-label="Pagination">
            {%- if paginate.previous -%}
              <a href="{{ paginate.previous.url }}" aria-label="Previous page">‹</a>
            {%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a href="{{ part.url }}">{{ part.title }}</a>
              {%- elsif part.title == paginate.current_page -%}
                <span aria-current="page">{{ part.title }}</span>
              {%- else -%}
                <span>{{ part.title }}</span>
              {%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}
              <a href="{{ paginate.next.url }}" aria-label="Next page">›</a>
            {%- endif -%}
          </nav>
        {%- endif -%}
      {%- else -%}
        <div class="fsg-plp__empty">
          <strong>{{ s.empty_heading }}</strong>
          <p>{{ s.empty_text }}</p>
          <a href="{{ routes.collections_url }}" class="fsg-btn fsg-btn--primary">Browse all categories</a>
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "FSG blog",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Guides & advice",
      "info": "Leave empty to use the blog's name."
    },
    {
      "type": "text",
      "id": "intro",
      "label": "Intro",
      "default": "How-to guides, product advice and news from the Facility Flooring and 4EarthSolutions team."
    },
    {
      "type": "range",
      "id": "per_page",
      "label": "Articles per page",
      "min": 6,
      "max": 24,
      "step": 3,
      "default": 12
    },
    {
      "type": "text",
      "id": "empty_heading",
      "label": "Heading when there are no articles",
      "default": "Guides are on the way"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Text when there are no articles",
      "default": "We're writing our first guides. In the meantime, our team is happy to help — just give us a call."
    }
  ]
}
{% endschema %}
