{%- liquid
  assign menu = section.settings.menu
  assign phone = section.settings.phone
  assign phone_href = phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-'
  assign email = section.settings.email
  assign logo_width = section.settings.logo_width
-%}

{%- if settings.cart_type == 'notification' -%}
  {{ 'component-cart-notification.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'cart-notification.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

<div class="fsg fsg-header" data-fsg-header>
  {%- comment -%} Utility bar {%- endcomment -%}
  {%- assign messages = section.blocks | where: 'type', 'message' -%}
  {%- if messages.size > 0 or section.settings.util_menu != blank -%}
    <div class="fsg-util">
      <div class="fsg-wrap fsg-util__inner">
        <ul class="fsg-util__msgs">
          {%- for block in messages -%}
            <li class="fsg-util__msg" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != 'none' -%}
                {% render 'fsg-icon', icon: block.settings.icon, size: 15 %}
              {%- endif -%}
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
              {%- else -%}
                <span>{{ block.settings.text }}</span>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
        {%- if section.settings.util_menu != blank -%}
          <nav class="fsg-util__links" aria-label="{{ section.settings.util_menu.title | escape }}">
            {%- for link in section.settings.util_menu.links -%}
              <a href="{{ link.url }}">{{ link.title }}</a>
            {%- endfor -%}
          </nav>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} Main row {%- endcomment -%}
  <div class="fsg-head">
    <div class="fsg-wrap fsg-head__inner">
      <button
        type="button"
        class="fsg-head__burger"
        data-fsg-drawer-open
        aria-controls="FsgDrawer-{{ section.id }}"
        aria-expanded="false"
        aria-label="{{ 'sections.header.menu' | t }}"
      >
        {% render 'fsg-icon', icon: 'menu', size: 24 %}
      </button>

      {%- capture logo -%}
        {%- if section.settings.logo != blank -%}
          {%- liquid
            assign logo_2x = logo_width | times: 2
            assign logo_height = section.settings.logo.height | times: logo_width | divided_by: section.settings.logo.width
            assign logo_style = 'width:' | append: logo_width | append: 'px'
          -%}
          {{
            section.settings.logo
            | image_url: width: logo_2x
            | image_tag: width: logo_width, height: logo_height, style: logo_style, alt: shop.name, loading: 'eager'
          }}
        {%- else -%}
          <span class="fsg-logo__mark" aria-hidden="true">{{ section.settings.logo_mark }}</span>
          <span class="fsg-logo__text">
            <span class="fsg-logo__name">{{ section.settings.logo_name | default: shop.name }}</span>
            {%- if section.settings.tagline != blank -%}
              <span class="fsg-logo__tag">{{ section.settings.tagline }}</span>
            {%- endif -%}
          </span>
        {%- endif -%}
      {%- endcapture -%}

      <a href="{{ routes.root_url }}" class="fsg-logo">{{ logo }}</a>

      {%- if section.settings.show_search -%}
        <div class="fsg-search">
          {%- if settings.predictive_search_enabled -%}
            <predictive-search data-loading-text="{{ 'accessibility.loading' | t }}">
          {%- else -%}
            <search-form>
          {%- endif -%}
          <form action="{{ routes.search_url }}" method="get" role="search" class="fsg-search__form">
            <label class="visually-hidden" for="FsgSearch-{{ section.id }}">{{ 'general.search.search' | t }}</label>
            <input
              class="fsg-search__input"
              id="FsgSearch-{{ section.id }}"
              type="search"
              name="q"
              value="{{ search.terms | escape }}"
              placeholder="{{ section.settings.search_placeholder | escape }}"
              {%- if settings.predictive_search_enabled %}
                role="combobox"
                aria-expanded="false"
                aria-owns="predictive-search-results"
                aria-controls="predictive-search-results"
                aria-haspopup="listbox"
                aria-autocomplete="list"
                autocorrect="off"
                autocomplete="off"
                autocapitalize="off"
                spellcheck="false"
              {%- endif %}
            >
            <input type="hidden" name="options[prefix]" value="last">
            <button type="reset" class="hidden" tabindex="-1" aria-hidden="true"></button>
            <button type="submit" class="fsg-search__btn" aria-label="{{ 'general.search.search' | t }}">
              {% render 'fsg-icon', icon: 'search', size: 19 %}
            </button>
            {%- if settings.predictive_search_enabled -%}
              <div class="predictive-search predictive-search--header" tabindex="-1" data-predictive-search>
                {%- render 'loading-spinner', class: 'predictive-search__loading-state' -%}
              </div>
              <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
            {%- endif -%}
          </form>
          {%- if settings.predictive_search_enabled -%}
            </predictive-search>
          {%- else -%}
            </search-form>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="fsg-head__actions">
        {%- if phone != blank -%}
          <a href="tel:{{ phone_href }}" class="fsg-call">
            <span class="fsg-call__icon">{% render 'fsg-icon', icon: 'phone', size: 18 %}</span>
            <span class="fsg-call__text">
              <small>{{ section.settings.phone_label }}</small>
              <strong>{{ phone }}</strong>
            </span>
            <span class="visually-hidden">{{ section.settings.phone_label }} {{ phone }}</span>
          </a>
        {%- endif -%}

        {%- if shop.customer_accounts_enabled -%}
          <a
            href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
            class="fsg-icon-btn fsg-head__account"
            rel="nofollow"
          >
            {% render 'fsg-icon', icon: 'user', size: 23 %}
            <span class="visually-hidden">
              {%- liquid
                if customer
                  echo 'customer.account.title' | t
                else
                  echo 'customer.log_in' | t
                endif
              -%}
            </span>
          </a>
        {%- endif -%}

        {%- comment -%}
          Dawn's cart drawer / notification re-renders this element's inner HTML
          from sections/cart-icon-bubble.liquid, so the markup below mirrors it.
        {%- endcomment -%}
        <a href="{{ routes.cart_url }}" class="fsg-icon-btn" id="cart-icon-bubble">
          {%- if cart == empty -%}
            <span class="svg-wrapper">{{ 'icon-cart-empty.svg' | inline_asset_content }}</span>
          {%- else -%}
            <span class="svg-wrapper">{{ 'icon-cart.svg' | inline_asset_content }}</span>
          {%- endif -%}
          <span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
          {%- if cart != empty -%}
            <div class="cart-count-bubble">
              {%- if cart.item_count < 100 -%}
                <span aria-hidden="true">{{ cart.item_count }}</span>
              {%- endif -%}
              <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
            </div>
          {%- endif -%}
        </a>
      </div>
    </div>
  </div>

  {%- comment -%} Category bar + mega menu {%- endcomment -%}
  {%- if menu != blank -%}
    {%- assign features = section.blocks | where: 'type', 'mega_feature' -%}
    <nav class="fsg-cats" aria-label="{{ menu.title | escape }}">
      <div class="fsg-wrap">
        <ul class="fsg-cats__list" role="list">
          {%- for link in menu.links -%}
            {%- liquid
              assign has_mega = false
              if link.links.size > 0
                assign has_mega = true
              endif
              assign is_accent = false
              if section.settings.accent_item != blank and link.title == section.settings.accent_item
                assign is_accent = true
              endif
            -%}
            <li class="fsg-cats__item{% if has_mega %} has-mega{% endif %}{% if is_accent %} fsg-cats__item--accent{% endif %}">
              <a
                href="{{ link.url }}"
                class="fsg-cats__link"
                {% if link.current %}
                  aria-current="page"
                {% endif %}
                {% if has_mega %}
                  aria-haspopup="true" aria-expanded="false"
                {% endif %}
              >
                {{- link.title | escape -}}
                {%- if has_mega -%}
                  {% render 'fsg-icon', icon: 'chevron-down', size: 15 %}
                {%- endif -%}
              </a>

              {%- if has_mega -%}
                <div class="fsg-mega">
                  <div class="fsg-wrap fsg-mega__inner">
                    <div class="fsg-mega__cols">
                      {%- for child in link.links -%}
                        <div class="fsg-mega__col">
                          <a href="{{ child.url }}" class="fsg-mega__heading">{{ child.title | escape }}</a>
                          {%- if child.links.size > 0 -%}
                            <ul class="fsg-mega__links" role="list">
                              {%- for grandchild in child.links -%}
                                <li>
                                  <a href="{{ grandchild.url }}">{{ grandchild.title | escape }}</a>
                                </li>
                              {%- endfor -%}
                            </ul>
                          {%- endif -%}
                        </div>
                      {%- endfor -%}
                      <div class="fsg-mega__col">
                        <a href="{{ link.url }}" class="fsg-mega__all">
                          {{- section.settings.view_all_label }}
                          {{ link.title | escape -}}
                          {% render 'fsg-icon', icon: 'arrow-right', size: 15 %}
                        </a>
                      </div>
                    </div>

                    <aside class="fsg-mega__side">
                      {%- liquid
                        assign feature = null
                        assign link_title = link.title | downcase | strip
                        for block in features
                          assign match = block.settings.menu_item | downcase | strip
                          if match == link_title
                            assign feature = block
                            break
                          endif
                        endfor
                      -%}
                      {%- if feature and feature.settings.product != blank -%}
                        {%- assign fp = feature.settings.product -%}
                        <a href="{{ fp.url }}" class="fsg-mega__feature" {{ feature.shopify_attributes }}>
                          <span class="fsg-mega__feature-media">
                            {%- if fp.featured_image -%}
                              {{
                                fp.featured_image
                                | image_url: width: 240
                                | image_tag: loading: 'lazy', widths: '120, 240', sizes: '96px', alt: fp.title
                              }}
                            {%- endif -%}
                          </span>
                          <span>
                            <small>{{ feature.settings.label | default: 'Featured' }}</small>
                            <strong>{{ fp.title }}</strong>
                            <span>
                              {%- if fp.price_varies -%}from {% endif -%}
                              {{- fp.price_min | money -}}
                            </span>
                          </span>
                        </a>
                      {%- endif -%}

                      {%- if section.settings.help_heading != blank -%}
                        <div class="fsg-mega__help">
                          <strong>{{ section.settings.help_heading }}</strong>
                          {%- if section.settings.help_text != blank -%}
                            <p>{{ section.settings.help_text }}</p>
                          {%- endif -%}
                          {%- if phone != blank -%}
                            <a href="tel:{{ phone_href }}">{% render 'fsg-icon', icon: 'phone', size: 16 %} {{ phone }}</a>
                          {%- endif -%}
                          {%- if email != blank -%}
                            <a href="mailto:{{ email }}">{% render 'fsg-icon', icon: 'mail', size: 16 %} {{ email }}</a>
                          {%- endif -%}
                        </div>
                      {%- endif -%}
                    </aside>
                  </div>
                </div>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </div>
    </nav>
  {%- endif -%}

  {%- comment -%} Mobile drawer {%- endcomment -%}
  <div class="fsg-drawer" id="FsgDrawer-{{ section.id }}" aria-hidden="true">
    <div class="fsg-drawer__overlay" data-fsg-drawer-close></div>
    <div class="fsg-drawer__panel" role="dialog" aria-modal="true" aria-label="{{ 'sections.header.menu' | t }}">
      <div class="fsg-drawer__top">
        <strong>{{ 'sections.header.menu' | t }}</strong>
        <button type="button" class="fsg-drawer__close" data-fsg-drawer-close aria-label="{{ 'accessibility.close' | t }}">
          {% render 'fsg-icon', icon: 'close', size: 20 %}
        </button>
      </div>
      <div class="fsg-drawer__body">
        {%- if menu != blank -%}
          <ul class="fsg-drawer__nav" role="list">
            {%- for link in menu.links -%}
              <li>
                {%- if link.links.size > 0 -%}
                  <details>
                    <summary>
                      {{- link.title | escape -}}
                      {% render 'fsg-icon', icon: 'chevron-down', size: 18 %}
                    </summary>
                    <ul class="fsg-drawer__sub" role="list">
                      {%- for child in link.links -%}
                        <li>
                          <a href="{{ child.url }}" class="fsg-drawer__l2">{{ child.title | escape }}</a>
                          {%- if child.links.size > 0 -%}
                            <ul role="list">
                              {%- for grandchild in child.links -%}
                                <li>
                                  <a href="{{ grandchild.url }}">{{ grandchild.title | escape }}</a>
                                </li>
                              {%- endfor -%}
                            </ul>
                          {%- endif -%}
                        </li>
                      {%- endfor -%}
                      <li>
                        <a href="{{ link.url }}" class="fsg-drawer__l2">
                          {{- section.settings.view_all_label }}
                          {{ link.title | escape -}}
                        </a>
                      </li>
                    </ul>
                  </details>
                {%- else -%}
                  <a href="{{ link.url }}" class="fsg-drawer__l1">{{ link.title | escape }}</a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        <div class="fsg-drawer__contact">
          {%- if phone != blank -%}
            <a href="tel:{{ phone_href }}">{% render 'fsg-icon', icon: 'phone', size: 18 %} {{ phone }}</a>
          {%- endif -%}
          {%- if email != blank -%}
            <a href="mailto:{{ email }}">{% render 'fsg-icon', icon: 'mail', size: 18 %} {{ email }}</a>
          {%- endif -%}
          {%- if shop.customer_accounts_enabled -%}
            <a href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}">
              {% render 'fsg-icon', icon: 'user', size: 18 %}
              {%- if customer %} {{ 'customer.account.title' | t }}{% else %} {{ 'customer.log_in' | t }}{% endif -%}
            </a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>

{%- if settings.cart_type == 'notification' -%}
  {%- render 'cart-notification', color_scheme: 'scheme-1', desktop_menu_type: 'mega' -%}
{%- endif -%}

<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if section.settings.logo %}
      "logo": {{ section.settings.logo | image_url: width: 500 | prepend: "https:" | json }},
    {% endif %}
    "url": {{ request.origin | append: page.url | json }}
  }
</script>

{% schema %}
{
  "name": "FSG header",
  "class": "fsg-sticky",
  "tag": "header",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image",
      "info": "Leave empty to use the text logo below."
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 80,
      "max": 300,
      "step": 5,
      "unit": "px",
      "default": 170
    },
    {
      "type": "text",
      "id": "logo_mark",
      "label": "Text logo mark",
      "default": "TFSG"
    },
    {
      "type": "text",
      "id": "logo_name",
      "label": "Text logo name",
      "info": "Defaults to the store name."
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Facility Flooring · 4EarthSolutions"
    },
    {
      "type": "header",
      "content": "Utility bar"
    },
    {
      "type": "link_list",
      "id": "util_menu",
      "label": "Utility menu",
      "info": "Small links on the right of the top bar."
    },
    {
      "type": "header",
      "content": "Search"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search",
      "default": true
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Search mats, trims, cleaners…"
    },
    {
      "type": "header",
      "content": "Contact"
    },
    {
      "type": "text",
      "id": "phone_label",
      "label": "Phone label",
      "default": "Call our specialists"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone",
      "default": "(085) 1234 899"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "info@facilityflooring.ie"
    },
    {
      "type": "header",
      "content": "Category bar and mega menu"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu",
      "info": "Level 1 = bar items, level 2 = column headings, level 3 = links."
    },
    {
      "type": "text",
      "id": "accent_item",
      "label": "Highlight menu item",
      "info": "Exact title of a top-level item to show in the accent colour, e.g. Logo Mats."
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all prefix",
      "default": "View all"
    },
    {
      "type": "text",
      "id": "help_heading",
      "label": "Help box heading",
      "default": "Need help choosing?"
    },
    {
      "type": "text",
      "id": "help_text",
      "label": "Help box text",
      "default": "Our specialists will measure, advise and quote — usually the same day."
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Top bar message",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "truck",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "truck", "label": "Delivery" },
            { "value": "shield", "label": "Warranty" },
            { "value": "check", "label": "Tick" },
            { "value": "clock", "label": "Clock" },
            { "value": "phone", "label": "Phone" },
            { "value": "leaf", "label": "Leaf" }
          ]
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Fast delivery across Ireland"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    },
    {
      "type": "mega_feature",
      "name": "Mega menu feature",
      "settings": [
        {
          "type": "text",
          "id": "menu_item",
          "label": "Menu item title",
          "info": "Shows in the mega menu of the top-level item with this exact title."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Best seller"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ]
}
{% endschema %}
