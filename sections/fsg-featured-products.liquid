{%- assign s = section.settings -%}

<section
  class="fsg fsg-sec fsg-featured{% if s.background == 'mist' %} fsg-sec--mist{% endif %}"
  style="--fsg-pt: {{ s.padding_top }}px; --fsg-pb: {{ s.padding_bottom }}px; --fsg-cols: {{ s.columns }};"
>
  <div class="fsg-wrap">
    <div class="fsg-sec-head">
      <div class="fsg-sec-head__text">
        {%- if s.eyebrow != blank -%}<p class="fsg-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="fsg-h2">{{ s.heading }}</h2>{%- endif -%}
      </div>
      {%- if s.link_label != blank and s.collection != blank -%}
        <a href="{{ s.collection.url }}" class="fsg-sec-head__link">
          {{- s.link_label }}
          {% render 'fsg-icon', icon: 'arrow-right', size: 16 -%}
        </a>
      {%- endif -%}
    </div>

    <ul class="fsg-featured__grid" role="list">
      {%- if s.collection != blank and s.collection.products_count > 0 -%}
        {%- for product in s.collection.products limit: s.limit -%}
          <li class="fsg-rv" style="--fsg-rv-delay: {{ forloop.index0 | modulo: s.columns | times: 0.05 }}s">
            {% render 'fsg-product-card',
              card_product: product,
              section_id: section.id,
              badge: s.badge,
              show_vendor: s.show_vendor
            %}
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..s.columns) -%}
          <li>
            <article class="fsg-card">
              <span class="fsg-card__media">{{ 'product-1' | placeholder_svg_tag: 'fsg-placeholder' }}</span>
              <div class="fsg-card__body">
                <h3 class="fsg-card__title">Product title</h3>
                <div class="fsg-card__foot">
                  <div class="fsg-card__price"><strong>{{ 4900 | money }}</strong></div>
                </div>
              </div>
            </article>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>

{%- if s.collection != blank -%}
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "FSG featured products",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Best sellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "In stock and ready to ship"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products to show",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge on available products",
      "default": "In stock"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": true
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "View all"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "default": "mist",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "mist", "label": "Mist" }
      ]
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "FSG featured products"
    }
  ]
}
{% endschema %}
