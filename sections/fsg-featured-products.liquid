{%- assign s = section.settings -%}

<section
  class="fsg fsg-sec fsg-featured{% if s.background == 'mist' %} fsg-sec--mist{% endif %}"
  style="--fsg-pt: {{ s.padding_top }}px; --fsg-pb: {{ s.padding_bottom }}px; --fsg-cols: {{ s.columns }};"
>
  <div class="fsg-wrap">
    <div class="fsg-sec-head">
      <div class="fsg-sec-head__text">
        {%- if s.eyebrow != blank -%}<p class="fsg-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="fsg-h2">{{ s.heading }}</h2>{%- endif -%}
      </div>
      {%- if s.link_label != blank and s.collection != blank -%}
        <a href="{{ s.collection.url }}" class="fsg-sec-head__link">
          {{- s.link_label }}
          {% render 'fsg-icon', icon: 'arrow-right', size: 16 -%}
        </a>
      {%- endif -%}
    </div>

    <ul class="fsg-featured__grid{% if s.slider %} fsg-featured__grid--slider{% endif %}" role="list"{% if s.slider %} data-fsg-slider-track tabindex="0" aria-label="{{ s.heading | escape }}"{% endif %}>
      {%- if s.collection != blank and s.collection.products_count > 0 -%}
        {%- for product in s.collection.products limit: s.limit -%}
          {%- comment -%} No scroll fade-in inside the slider: items scrolled in sideways never trigger it. {%- endcomment -%}
          <li{% unless s.slider %} class="fsg-rv" style="--fsg-rv-delay: {{ forloop.index0 | modulo: s.columns | times: 0.05 }}s"{% endunless %}>
            {% render 'fsg-product-card',
              card_product: product,
              section_id: section.id,
              badge: s.badge,
              show_vendor: s.show_vendor
            %}
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..s.columns) -%}
          <li>
            <article class="fsg-card">
              <span class="fsg-card__media">{{ 'product-1' | placeholder_svg_tag: 'fsg-placeholder' }}</span>
              <div class="fsg-card__body">
                <h3 class="fsg-card__title">Product title</h3>
                <div class="fsg-card__foot">
                  <div class="fsg-card__price"><strong>{{ 4900 | money }}</strong></div>
                </div>
              </div>
            </article>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>

    {%- if s.slider -%}
      <div class="fsg-slider-nav" data-fsg-slider-nav hidden>
        <button type="button" class="fsg-slider-nav__btn" data-fsg-slider-prev aria-label="Previous products">
          {% render 'fsg-icon', icon: 'chevron-left', size: 18 %}
        </button>
        <div class="fsg-slider-nav__dots" data-fsg-slider-dots></div>
        <button type="button" class="fsg-slider-nav__btn" data-fsg-slider-next aria-label="Next products">
          {% render 'fsg-icon', icon: 'chevron-right', size: 18 %}
        </button>
      </div>
    {%- endif -%}
  </div>
</section>

{%- if s.slider -%}
  <script>
    (function () {
      var root = document.currentScript.previousElementSibling;
      var track = root.querySelector('[data-fsg-slider-track]');
      var nav = root.querySelector('[data-fsg-slider-nav]');
      if (!track || !nav) return;
      var prev = nav.querySelector('[data-fsg-slider-prev]');
      var next = nav.querySelector('[data-fsg-slider-next]');
      var dotsWrap = nav.querySelector('[data-fsg-slider-dots]');
      var pages = 0;

      function pageCount() {
        return Math.max(1, Math.round(track.scrollWidth / track.clientWidth));
      }
      function current() {
        var max = track.scrollWidth - track.clientWidth;
        if (max <= 0) return 0;
        return Math.round((track.scrollLeft / max) * (pages - 1));
      }
      function go(i) {
        var max = track.scrollWidth - track.clientWidth;
        var target = pages > 1 ? (max / (pages - 1)) * i : 0;
        track.scrollTo({ left: target, behavior: 'smooth' });
      }
      function build() {
        pages = pageCount();
        nav.hidden = pages < 2;
        dotsWrap.innerHTML = '';
        for (var i = 0; i < pages; i++) {
          var d = document.createElement('button');
          d.type = 'button';
          d.className = 'fsg-slider-nav__dot';
          d.setAttribute('aria-label', 'Page ' + (i + 1) + ' of ' + pages);
          d.addEventListener('click', go.bind(null, i));
          dotsWrap.appendChild(d);
        }
        update();
      }
      function update() {
        var c = current();
        prev.disabled = c <= 0;
        next.disabled = c >= pages - 1;
        Array.prototype.forEach.call(dotsWrap.children, function (d, i) {
          d.setAttribute('aria-current', i === c ? 'true' : 'false');
        });
      }
      prev.addEventListener('click', function () { go(Math.max(0, current() - 1)); });
      next.addEventListener('click', function () { go(Math.min(pages - 1, current() + 1)); });
      var t;
      track.addEventListener('scroll', function () { clearTimeout(t); t = setTimeout(update, 60); }, { passive: true });
      window.addEventListener('resize', function () { clearTimeout(t); t = setTimeout(build, 150); });
      build();
    })();
  </script>
{%- endif -%}

{%- if s.collection != blank -%}
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "FSG featured products",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Best sellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "In stock and ready to ship"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products to show",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge on available products",
      "default": "In stock"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "slider",
      "label": "Show one row with arrows",
      "info": "Products scroll sideways with left/right arrows and page dots below.",
      "default": false
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "View all"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "default": "mist",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "mist", "label": "Mist" }
      ]
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "FSG featured products"
    }
  ]
}
{% endschema %}
