{%- liquid
  assign s = section.settings
  assign has_articles = false
  if s.blog != blank and s.blog.articles_count > 0
    assign has_articles = true
  endif
-%}

{%- comment -%} Placeholders only show in the theme editor; customers see nothing until the blog has articles. {%- endcomment -%}
{%- if has_articles or request.design_mode -%}

<section
  class="fsg fsg-sec fsg-guides{% if s.background == 'mist' %} fsg-sec--mist{% endif %}"
  style="--fsg-pt: {{ s.padding_top }}px; --fsg-pb: {{ s.padding_bottom }}px;"
>
  <div class="fsg-wrap">
    <div class="fsg-sec-head">
      <div class="fsg-sec-head__text">
        {%- if s.eyebrow != blank -%}<p class="fsg-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="fsg-h2">{{ s.heading }}</h2>{%- endif -%}
      </div>
      {%- if s.link_label != blank and s.blog != blank -%}
        <a href="{{ s.blog.url }}" class="fsg-sec-head__link">
          {{- s.link_label }}
          {% render 'fsg-icon', icon: 'arrow-right', size: 16 -%}
        </a>
      {%- endif -%}
    </div>

    <ul class="fsg-guides__grid" role="list">
      {%- if has_articles -%}
        {%- for article in s.blog.articles limit: s.count -%}
          <li class="fsg-rv" style="--fsg-rv-delay: {{ forloop.index0 | times: 0.06 }}s">
            <a href="{{ article.url }}" class="fsg-guide">
              <span class="fsg-guide__media">
                {%- if article.image -%}
                  {{
                    article.image
                    | image_url: width: 900
                    | image_tag:
                      widths: '360, 540, 720, 900',
                      sizes: '(min-width: 990px) 420px, 100vw',
                      loading: 'lazy',
                      alt: article.title
                  }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'fsg-placeholder' }}
                {%- endif -%}
              </span>
              <span class="fsg-guide__body">
                <span class="fsg-guide__meta">{{ article.published_at | time_tag: format: 'date' }}</span>
                <span class="fsg-guide__title">{{ article.title | escape }}</span>
                {%- if article.excerpt_or_content != blank -%}
                  <span class="fsg-guide__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 22 }}</span>
                {%- endif -%}
                <span class="fsg-guide__more">
                  {{- s.read_label }}
                  {% render 'fsg-icon', icon: 'arrow-right', size: 15 -%}
                </span>
              </span>
            </a>
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- assign placeholders = 'How to choose the right entrance mat|Measuring a matwell: a step-by-step guide|Sealing and protecting stone floors' | split: '|' -%}
        {%- for title in placeholders limit: s.count -%}
          <li>
            <div class="fsg-guide">
              <span class="fsg-guide__media">{{ 'image' | placeholder_svg_tag: 'fsg-placeholder' }}</span>
              <span class="fsg-guide__body">
                <span class="fsg-guide__meta">Guide</span>
                <span class="fsg-guide__title">{{ title }}</span>
                <span class="fsg-guide__excerpt">Pick a blog in the theme editor to show real articles here.</span>
              </span>
            </div>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "FSG guides",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Guides & advice"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Know before you buy"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "count",
      "label": "Articles to show",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "text",
      "id": "read_label",
      "label": "Read more label",
      "default": "Read guide"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "All guides"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "default": "white",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "mist", "label": "Mist" }
      ]
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "FSG guides"
    }
  ]
}
{% endschema %}
