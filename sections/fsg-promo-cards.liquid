{%- assign s = section.settings -%}

<section class="fsg fsg-sec fsg-promos" style="--fsg-pt: {{ s.padding_top }}px; --fsg-pb: {{ s.padding_bottom }}px;">
  <div class="fsg-wrap">
    <div class="fsg-promos__grid">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <a
          href="{{ b.link | default: routes.all_products_collection_url }}"
          class="fsg-promo fsg-rv"
          style="--fsg-rv-delay: {{ forloop.index0 | times: 0.06 }}s"
          {{ block.shopify_attributes }}
        >
          <span class="fsg-promo__media">
            {% render 'fsg-image',
              image: b.image,
              product: b.fallback_product,
              photo: b.fallback_photo,
              sizes: '(min-width: 750px) 640px, 100vw'
            %}
          </span>
          <span class="fsg-promo__body">
            {%- if b.eyebrow != blank -%}
              <span class="fsg-eyebrow fsg-promo__eyebrow">{{ b.eyebrow }}</span>
            {%- endif -%}
            <span class="fsg-promo__title">{{ b.heading }}</span>
            {%- if b.text != blank -%}
              <span class="fsg-promo__text">{{ b.text }}</span>
            {%- endif -%}
            {%- if b.button_label != blank -%}
              <span class="fsg-btn fsg-btn--light fsg-btn--sm fsg-promo__btn">
                {{- b.button_label }}
                {% render 'fsg-icon', icon: 'arrow-right', size: 16 -%}
              </span>
            {%- endif -%}
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FSG promo cards",
  "tag": "div",
  "settings": [
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "limit": 3,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "product",
          "id": "fallback_product",
          "label": "Use a product photo",
          "info": "Used when no image is uploaded."
        },
        {
          "type": "range",
          "id": "fallback_photo",
          "label": "Product photo number",
          "min": 1,
          "max": 10,
          "step": 1,
          "default": 1
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Card heading"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FSG promo cards",
      "blocks": [{ "type": "card" }, { "type": "card" }]
    }
  ]
}
{% endschema %}
