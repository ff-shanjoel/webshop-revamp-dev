{%- liquid
  assign s = section.settings
  assign ship_text = ''
  if s.show_delivery
    assign ship_text = s.ship_text
  endif

  # Category chips: find the menu item this collection sits under and show its siblings,
  # so shoppers can hop between ranges without going back to the menu.
  assign chip_parent = null
  if s.menu != blank
    for link in s.menu.links
      if link.links.size == 0
        continue
      endif
      if link.url == collection.url
        assign chip_parent = link
        break
      endif
      for child in link.links
        if child.url == collection.url
          assign chip_parent = link
          break
        endif
      endfor
      if chip_parent
        break
      endif
    endfor
  endif
-%}

{{ 'fsg-pages.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

<section class="fsg fsg-plp" data-fsg-plp>
  <div class="fsg-wrap">
    <nav class="fsg-crumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      {%- if chip_parent and chip_parent.url != collection.url -%}
        {% render 'fsg-icon', icon: 'chevron-right', size: 13 %}
        <a href="{{ chip_parent.url }}">{{ chip_parent.title | escape }}</a>
      {%- endif -%}
      {% render 'fsg-icon', icon: 'chevron-right', size: 13 %}
      <span aria-current="page">{{ collection.title | escape }}</span>
    </nav>

    <header class="fsg-plp__head">
      <h1 class="fsg-plp__title">{{ collection.title | escape }}</h1>
      <p class="fsg-plp__count">
        {{ collection.products_count }}
        {% if collection.products_count == 1 %}product{% else %}products{% endif %}
      </p>
      {%- if collection.description != blank and s.show_description -%}
        <div class="fsg-rte fsg-plp__desc is-clamped" data-fsg-desc>{{ collection.description }}</div>
        <button type="button" class="fsg-plp__more" data-fsg-desc-toggle hidden>Read more</button>
      {%- endif -%}
    </header>

    {%- if chip_parent -%}
      <nav class="fsg-chips" aria-label="{{ chip_parent.title | escape }}">
        <a href="{{ chip_parent.url }}" class="fsg-chip{% if chip_parent.url == collection.url %} is-active{% endif %}" style="padding-left:14px">
          All
        </a>
        {%- for child in chip_parent.links -%}
          {%- liquid
            assign chip_img = null
            if child.type == 'collection_link'
              assign chip_img = child.object.products.first.featured_image | default: child.object.image
            endif
          -%}
          <a href="{{ child.url }}" class="fsg-chip{% if child.url == collection.url %} is-active{% endif %}">
            {%- if chip_img -%}
              {{ chip_img | image_url: width: 80 | image_tag: loading: 'lazy', alt: '' }}
            {%- endif -%}
            {{ child.title | escape }}
          </a>
        {%- endfor -%}
      </nav>
    {%- endif -%}

    {%- comment -%} Filters + sort (Shopify storefront filters; set them up in the Search & Discovery app) {%- endcomment -%}
    <form class="fsg-plp__form" action="{{ collection.url }}" method="get" data-fsg-filter-form>
      <div class="fsg-toolbar">
        <div class="fsg-filters">
          {%- for filter in collection.filters -%}
            {%- liquid
              assign active_count = filter.active_values.size
              if filter.type == 'price_range'
                assign active_count = 0
                if filter.min_value.value != null or filter.max_value.value != null
                  assign active_count = 1
                endif
              endif
            -%}
            <details class="fsg-filter" data-fsg-filter>
              <summary>
                {{ filter.label | escape }}
                {%- if active_count > 0 -%}
                  <span class="fsg-filter__count">{{ active_count }}</span>
                {%- endif -%}
                {% render 'fsg-icon', icon: 'chevron-down', size: 15 %}
              </summary>
              <div class="fsg-filter__panel">
                {%- case filter.type -%}
                  {%- when 'price_range' -%}
                    <div class="fsg-filter__price">
                      <label>
                        From €
                        <input
                          type="number"
                          name="{{ filter.min_value.param_name }}"
                          value="{% if filter.min_value.value %}{{ filter.min_value.value | money_without_currency | remove: ',' }}{% endif %}"
                          placeholder="0"
                          min="0"
                          inputmode="decimal"
                        >
                      </label>
                      <label>
                        To €
                        <input
                          type="number"
                          name="{{ filter.max_value.param_name }}"
                          value="{% if filter.max_value.value %}{{ filter.max_value.value | money_without_currency | remove: ',' }}{% endif %}"
                          placeholder="{{ filter.range_max | money_without_currency | remove: ',' }}"
                          min="0"
                          inputmode="decimal"
                        >
                      </label>
                      <button type="submit" class="fsg-btn fsg-btn--primary fsg-btn--sm fsg-filter__apply">Apply</button>
                    </div>
                  {%- else -%}
                    {%- for value in filter.values -%}
                      <label class="fsg-filter__opt{% if value.count == 0 and value.active == false %} is-disabled{% endif %}">
                        <input
                          type="checkbox"
                          name="{{ value.param_name }}"
                          value="{{ value.value }}"
                          {% if value.active %}
                            checked
                          {% endif %}
                          data-fsg-autosubmit
                        >
                        <span>{{ value.label | escape }}</span>
                        <small>{{ value.count }}</small>
                      </label>
                    {%- endfor -%}
                {%- endcase -%}
              </div>
            </details>
          {%- endfor -%}
        </div>

        <label class="fsg-sort">
          Sort by
          <select name="sort_by" data-fsg-autosubmit>
            {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected{% endif %}>
                {{- option.name | escape -}}
              </option>
            {%- endfor -%}
          </select>
        </label>
      </div>

      {%- liquid
        assign has_active = false
        for filter in collection.filters
          if filter.active_values.size > 0
            assign has_active = true
          endif
          if filter.type == 'price_range'
            if filter.min_value.value != null or filter.max_value.value != null
              assign has_active = true
            endif
          endif
        endfor
      -%}
      {%- if has_active -%}
        <div class="fsg-active">
          {%- for filter in collection.filters -%}
            {%- for value in filter.active_values -%}
              <a href="{{ value.url_to_remove }}">
                {{ value.label | escape }}
                {% render 'fsg-icon', icon: 'close', size: 13 %}
              </a>
            {%- endfor -%}
            {%- if filter.type == 'price_range' -%}
              {%- if filter.min_value.value != null or filter.max_value.value != null -%}
                <a href="{{ filter.url_to_remove }}">
                  {{ filter.min_value.value | default: 0 | money }} – {{ filter.max_value.value | default: filter.range_max | money }}
                  {% render 'fsg-icon', icon: 'close', size: 13 %}
                </a>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          <a href="{{ collection.url }}?sort_by={{ sort_by }}" class="fsg-active__clear">Clear all</a>
        </div>
      {%- endif -%}
    </form>

    {%- paginate collection.products by s.per_page -%}
      {%- if collection.products.size > 0 -%}
        <ul class="fsg-plp__grid" role="list">
          {%- for product in collection.products -%}
            <li>
              {%- assign eager = false -%}
              {%- if forloop.index <= 4 -%}{%- assign eager = true -%}{%- endif -%}
              {% render 'fsg-product-card',
                card_product: product,
                section_id: section.id,
                badge: s.badge,
                show_vendor: s.show_vendor,
                ship_text: ship_text,
                mto_tag: s.mto_tag,
                eager: eager
              %}
            </li>
          {%- endfor -%}
        </ul>

        {%- if paginate.pages > 1 -%}
          <nav class="fsg-pages" aria-label="Pagination">
            {%- if paginate.previous -%}
              <a href="{{ paginate.previous.url }}" aria-label="Previous page">‹</a>
            {%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a href="{{ part.url }}">{{ part.title }}</a>
              {%- elsif part.title == paginate.current_page -%}
                <span aria-current="page">{{ part.title }}</span>
              {%- else -%}
                <span>{{ part.title }}</span>
              {%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}
              <a href="{{ paginate.next.url }}" aria-label="Next page">›</a>
            {%- endif -%}
          </nav>
        {%- endif -%}
      {%- else -%}
        <div class="fsg-plp__empty">
          <strong>No products found</strong>
          {%- if has_active -%}
            <p>Try removing a filter.</p>
            <a href="{{ collection.url }}" class="fsg-btn fsg-btn--primary">Clear filters</a>
          {%- else -%}
            <p>This range is being restocked. Have a look at our other categories.</p>
            <a href="{{ routes.collections_url }}" class="fsg-btn fsg-btn--primary">Browse all categories</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

<script>
  (() => {
    const root = document.currentScript.previousElementSibling;
    const form = root.querySelector('[data-fsg-filter-form]');
    // Submit straight away when a filter or the sort order changes; drop empty fields from the URL.
    form?.addEventListener('change', (e) => {
      if (!e.target.matches('[data-fsg-autosubmit]')) return;
      root.classList.add('is-loading');
      form.requestSubmit();
    });
    form?.addEventListener('submit', () => {
      form.querySelectorAll('input[type="number"]').forEach((i) => {
        if (i.value === '') i.disabled = true;
      });
    });
    // Close other filter dropdowns when one opens, and when clicking elsewhere.
    const filters = [...root.querySelectorAll('[data-fsg-filter]')];
    filters.forEach((d) =>
      d.addEventListener('toggle', () => d.open && filters.forEach((o) => o !== d && (o.open = false)))
    );
    document.addEventListener('click', (e) => {
      if (!e.target.closest('[data-fsg-filter]')) filters.forEach((d) => (d.open = false));
    });
    root.querySelector('.fsg-chip.is-active')?.scrollIntoView({ block: 'nearest', inline: 'center' });
    // Show "Read more" only when the description is actually cut off.
    const desc = root.querySelector('[data-fsg-desc]');
    const more = root.querySelector('[data-fsg-desc-toggle]');
    if (desc && more && desc.scrollHeight > desc.clientHeight + 2) {
      more.hidden = false;
      more.addEventListener('click', () => {
        const clamped = desc.classList.toggle('is-clamped');
        more.textContent = clamped ? 'Read more' : 'Read less';
      });
    }
  })();
</script>

{% schema %}
{
  "name": "FSG collection",
  "tag": "div",
  "settings": [
    {
      "type": "range",
      "id": "per_page",
      "label": "Products per page",
      "min": 12,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show collection description",
      "default": true
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Category chips menu",
      "default": "main-menu",
      "info": "Shows the other ranges from the same menu group as quick links."
    },
    {
      "type": "header",
      "content": "Product cards"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge on available products",
      "default": "In stock"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_delivery",
      "label": "Show delivery line",
      "default": true
    },
    {
      "type": "text",
      "id": "ship_text",
      "label": "Delivery line",
      "default": "Delivery in 2–3 working days"
    },
    {
      "type": "text",
      "id": "mto_tag",
      "label": "Made-to-order product tag",
      "default": "Logo Mats"
    }
  ]
}
{% endschema %}
