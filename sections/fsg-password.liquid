{%- liquid
  assign s = section.settings
  assign phone_href = s.phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-'
-%}

<section class="fsg fsg-pw">
  <div class="fsg-pw__panel">
    <a href="{{ routes.root_url }}" class="fsg-pw__logo">
      {%- if s.logo != blank -%}
        {{ s.logo | image_url: width: 480 | image_tag: alt: shop.name, style: 'width:240px' }}
      {%- else -%}
        <img src="{{ 'fsg-logo-light.png' | asset_url }}" alt="{{ shop.name | escape }}" width="800" height="134" style="width:240px">
      {%- endif -%}
    </a>

    <div class="fsg-pw__body">
      {%- if s.eyebrow != blank -%}<p class="fsg-eyebrow fsg-pw__eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      <h1 class="fsg-pw__title">{{ s.heading }}</h1>
      {%- if s.text != blank -%}<div class="fsg-rte fsg-pw__text">{{ s.text }}</div>{%- endif -%}

      {%- form 'customer', class: 'fsg-pw__signup' -%}
        <input type="hidden" name="contact[tags]" value="prospect,password page">
        {%- if form.posted_successfully? -%}
          <p class="fsg-form__ok" role="status">
            {% render 'fsg-icon', icon: 'check', size: 18 %}
            <span>{{ s.success_text }}</span>
          </p>
        {%- else -%}
          <label class="visually-hidden" for="FsgPwEmail">Email</label>
          <div class="fsg-pw__row">
            <input
              id="FsgPwEmail"
              type="email"
              name="contact[email]"
              autocomplete="email"
              placeholder="Your email address"
              required
            >
            <button type="submit" class="fsg-btn fsg-btn--light">{{ s.button_label }}</button>
          </div>
          {%- if form.errors -%}
            <p class="fsg-pw__err" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
          {%- endif -%}
        {%- endif -%}
      {%- endform -%}

      <div class="fsg-pw__contact">
        {%- if s.phone != blank -%}
          <a href="tel:{{ phone_href }}">{% render 'fsg-icon', icon: 'phone', size: 17 %} {{ s.phone }}</a>
        {%- endif -%}
        {%- if s.email != blank -%}
          <a href="mailto:{{ s.email }}">{% render 'fsg-icon', icon: 'mail', size: 17 %} {{ s.email }}</a>
        {%- endif -%}
      </div>
    </div>

    <details class="fsg-pw__owner">
      <summary>Store owner? Enter the password</summary>
      {%- form 'storefront_password', class: 'fsg-pw__owner-form' -%}
        <label class="visually-hidden" for="FsgPwPassword">Password</label>
        <div class="fsg-pw__row">
          <input id="FsgPwPassword" type="password" name="password" autocomplete="current-password" placeholder="Password" required>
          <button type="submit" class="fsg-btn fsg-btn--ghost">Enter</button>
        </div>
        {%- if form.errors -%}
          <p class="fsg-pw__err" role="alert">{{ form.errors | default_errors }}</p>
        {%- endif -%}
      {%- endform -%}
      <p class="fsg-pw__admin">Are you the store owner? <a href="/admin">Log in here</a></p>
    </details>
  </div>

  <div class="fsg-pw__media" aria-hidden="true">
    {% render 'fsg-image',
      image: s.image,
      product: s.fallback_product,
      photo: s.fallback_photo,
      sizes: '50vw',
      eager: true
    %}
  </div>
</section>

<script>
  // Keep the owner login open if the password was wrong.
  document.querySelectorAll('.fsg-pw__owner').forEach((d) => {
    if (d.querySelector('.fsg-pw__err')) d.open = true;
  });
</script>

{% schema %}
{
  "name": "FSG coming soon",
  "tag": "div",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Leave empty to use the white theme logo."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Something new is on the way"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our new online shop is opening soon"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Entrance matting, trims, wall protection and eco floor care — all in one place. Leave your email and we'll tell you the moment we launch.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Notify me"
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "Thank-you message",
      "default": "Thanks — we'll email you when we open."
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone",
      "default": "(085) 1234 899"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "info@facilityflooring.ie"
    },
    {
      "type": "header",
      "content": "Photo"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "product",
      "id": "fallback_product",
      "label": "Use a product photo",
      "info": "Used when no image is uploaded."
    },
    {
      "type": "range",
      "id": "fallback_photo",
      "label": "Product photo number",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 1
    }
  ]
}
{% endschema %}
