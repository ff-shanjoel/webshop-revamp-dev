{% layout none %}
{%- comment -%}
  FSG gift card page: the page customers open from their gift card email.
  Standalone (no theme header/footer); styles are at the bottom of the head.
{%- endcomment -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="canonical" href="{{ canonical_url }}">
    {% render 'fsg-favicon' %}

    {%- assign formatted_balance = gift_card.balance | money_without_trailing_zeros | strip_html -%}
    <title>{{ 'gift_cards.issued.title' | t: value: formatted_balance, shop: shop.name }}</title>
    <meta name="description" content="{{ 'gift_cards.issued.subtext' | t }}">

    {{ content_for_header }}

    {% render 'fsg-tokens' %}
    {{ 'fsg-base.css' | asset_url | stylesheet_tag }}
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        background: var(--fsg-mist);
        font-family: var(--fsg-font);
      }
      .fsg-gc {
        display: grid;
        justify-items: center;
        gap: 28px;
        max-width: 560px;
        margin: 0 auto;
        padding: 40px 20px 56px;
        text-align: center;
      }
      .fsg-gc__logo img {
        width: 200px;
        height: auto;
      }
      .fsg-gc__intro h1 {
        font-size: clamp(26px, 5vw, 34px);
        font-weight: 800;
        letter-spacing: -0.02em;
      }
      .fsg-gc__intro p {
        margin-top: 6px;
        font-size: 16px;
      }
      /* The card itself */
      .fsg-gc__card {
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        width: 100%;
        aspect-ratio: 1.6;
        padding: clamp(20px, 5vw, 32px);
        border-radius: 20px;
        background:
          radial-gradient(circle at 85% 15%, rgba(74, 120, 176, 0.55), transparent 55%),
          linear-gradient(135deg, var(--fsg-slate-dark), var(--fsg-slate));
        box-shadow: 0 24px 48px rgba(22, 34, 47, 0.25);
        color: var(--fsg-white);
        text-align: left;
        overflow: hidden;
      }
      .fsg-gc__card-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
      }
      .fsg-gc__card-top img {
        width: 140px;
        height: auto;
      }
      .fsg-gc__label {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: #a9c1db;
      }
      .fsg-gc__balance {
        font-size: clamp(36px, 10vw, 56px);
        font-weight: 800;
        line-height: 1;
        letter-spacing: -0.03em;
      }
      .fsg-gc__expiry {
        margin-top: 8px;
        font-size: 13px;
        color: rgba(255, 255, 255, 0.7);
      }
      .fsg-gc__badge {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 999px;
        background: #fbeceb;
        color: #9a2f27;
        font-size: 12px;
        font-weight: 700;
      }
      /* Code box */
      .fsg-gc__code-box {
        display: grid;
        gap: 14px;
        width: 100%;
        padding: 22px;
        border: 1px solid var(--fsg-line);
        border-radius: var(--fsg-radius-lg);
        background: var(--fsg-white);
      }
      .fsg-gc__code-box small {
        font-size: 13px;
        color: var(--fsg-ink-3);
      }
      .fsg-gc__code {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        flex-wrap: wrap;
      }
      .fsg-gc__code strong {
        padding: 10px 16px;
        border: 2px dashed var(--fsg-line);
        border-radius: var(--fsg-radius);
        font-size: 20px;
        letter-spacing: 0.08em;
        color: var(--fsg-ink);
      }
      .fsg-gc__copied {
        min-height: 20px;
        font-size: 14px;
        font-weight: 600;
        color: #2f6b4f;
      }
      .fsg-gc__qr {
        display: flex;
        justify-content: center;
      }
      .fsg-gc__qr img,
      .fsg-gc__qr canvas {
        padding: 8px;
        border: 1px solid var(--fsg-line);
        border-radius: var(--fsg-radius);
        background: var(--fsg-white);
      }
      .fsg-gc__steps {
        display: grid;
        gap: 8px;
        width: 100%;
        padding: 0;
        margin: 0;
        list-style: none;
        text-align: left;
      }
      .fsg-gc__steps li {
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 14.5px;
        color: var(--fsg-ink);
      }
      .fsg-gc__steps span {
        display: grid;
        place-items: center;
        flex: none;
        width: 26px;
        height: 26px;
        border-radius: 50%;
        background: var(--fsg-slate);
        color: var(--fsg-white);
        font-size: 12px;
        font-weight: 800;
      }
      .fsg-gc__actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 10px;
      }
      @media print {
        .no-print {
          display: none !important;
        }
        body {
          background: #fff;
        }
      }
    </style>
  </head>

  <body>
    <main class="fsg fsg-gc">
      <a href="{{ shop.url }}" class="fsg-gc__logo">
        {%- if settings.logo != blank -%}
          {{ settings.logo | image_url: width: 400 | image_tag: alt: shop.name }}
        {%- else -%}
          <img src="{{ 'fsg-logo-dark.png' | asset_url }}" alt="{{ shop.name | escape }}" width="800" height="134">
        {%- endif -%}
      </a>

      <div class="fsg-gc__intro">
        <h1>Here's your gift card</h1>
        <p>{{ 'gift_cards.issued.how_to_use_gift_card' | t }}</p>
      </div>

      <div class="fsg-gc__card">
        <div class="fsg-gc__card-top">
          <img src="{{ 'fsg-logo-light.png' | asset_url }}" alt="" width="800" height="134">
          <span class="fsg-gc__label">Gift card</span>
        </div>
        <div>
          {%- if gift_card.enabled == false or gift_card.expired -%}
            <span class="fsg-gc__badge">{{ 'gift_cards.issued.expired' | t }}</span>
          {%- endif -%}
          <p class="fsg-gc__balance">
            {%- if settings.currency_code_enabled -%}
              {{ gift_card.balance | money_with_currency }}
            {%- else -%}
              {{ gift_card.balance | money }}
            {%- endif -%}
          </p>
          {%- if gift_card.expires_on -%}
            {%- assign gift_card_expiration_date = gift_card.expires_on | date: '%e %B %Y' -%}
            <p class="fsg-gc__expiry">{{ 'gift_cards.issued.expiration_date' | t: expires_on: gift_card_expiration_date }}</p>
          {%- endif -%}
        </div>
      </div>

      <div class="fsg-gc__code-box">
        <small>Your gift card code</small>
        <div class="fsg-gc__code">
          <strong id="gift-card-code">{{ gift_card.code | format_code }}</strong>
          <button type="button" class="fsg-btn fsg-btn--outline fsg-btn--sm no-print" data-fsg-copy-code>
            {{- 'gift_cards.issued.copy_code' | t -}}
          </button>
        </div>
        <p class="fsg-gc__copied no-print" role="status" data-fsg-copied></p>
        <div class="fsg-gc__qr" data-identifier="{{ gift_card.qr_identifier }}"></div>
        {%- if gift_card.pass_url -%}
          <a href="{{ gift_card.pass_url }}" class="no-print">
            <img
              src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}"
              width="120"
              height="40"
              alt="{{ 'gift_cards.issued.add_to_apple_wallet' | t }}"
              loading="lazy"
            >
          </a>
        {%- endif -%}
      </div>

      <ol class="fsg-gc__steps" role="list">
        <li><span>1</span> Add the products you want to your basket</li>
        <li><span>2</span> At checkout, enter the code above in the gift card box</li>
        <li><span>3</span> Any balance left stays on the card for next time</li>
      </ol>

      <div class="fsg-gc__actions no-print">
        <a href="{{ shop.url }}" class="fsg-btn fsg-btn--primary">{{ 'gift_cards.issued.shop_link' | t }}</a>
        <button type="button" class="fsg-btn fsg-btn--outline" onclick="window.print()">Print</button>
      </div>
    </main>

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const qr = document.querySelector('.fsg-gc__qr');
        if (qr && window.QRCode) {
          new QRCode(qr, {
            text: qr.dataset.identifier,
            width: 96,
            height: 96,
            imageAltText: {{ 'gift_cards.issued.qr_image_alt' | t | json }},
          });
        }
        const btn = document.querySelector('[data-fsg-copy-code]');
        const out = document.querySelector('[data-fsg-copied]');
        btn?.addEventListener('click', () => {
          navigator.clipboard?.writeText(document.getElementById('gift-card-code').innerText).then(() => {
            out.textContent = {{ 'gift_cards.issued.copy_code_success' | t | json }};
          });
        });
      });
    </script>
  </body>
</html>
